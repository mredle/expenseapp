# Fail fast when the local Node/npm does not match the versions declared in
# package.json "engines".
#
# The lockfile must be reproducible across dev, CI and production. npm 11
# resolves peer dependencies differently from npm 10 and cannot resolve this
# Angular 20 dependency set at all, so a lockfile generated with the wrong npm
# is unusable on the server (which runs Node 22.x / npm 10.x via NodeSource).
engine-strict=true
