[Unit]
Description=ExpenseApp
After=network.target
# If the unit fails 5 times within 1 hour, stop auto-retrying (avoids endless
# 3-minute mobile-rebuild restart loops on persistent failures).
# To reset after hitting this limit: sudo systemctl reset-failed expenseapp
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=expenseapp
Group=expenseapp
WorkingDirectory=/opt/expenseapp/
# HOME must point to a writable directory owned by the expenseapp user.
# A system account created without -m has no real home; set it explicitly here
# so npm, Angular CLI, and fontconfig find a writable cache location.
# Run scripts/prod/setup_service_user.sh once after deployment to ensure
# /opt/expenseapp is owned by expenseapp:expenseapp.
Environment=HOME=/opt/expenseapp
Environment=npm_config_cache=/opt/expenseapp/.npm
ExecStart=/opt/expenseapp/run_as_service.sh

# Poll the app on IPv4 (gunicorn binds 0.0.0.0, and localhost resolves to
# ::1 first on this host — which is not what gunicorn listens on). /metrics
# returns 200 without auth; each attempt is time-bounded so a busy worker
# cannot wedge the probe indefinitely.
ExecStartPost=/bin/bash -c 'until curl --silent --fail --max-time 5 --output /dev/null http://127.0.0.1:5000/metrics; do sleep 2; done'

# If it doesn't answer within 900 seconds, kill it and fail.
# The first start builds the mobile PWA (npm ci + Angular production build),
# which can take several minutes on low-power / RPi hosts.
TimeoutStartSec=900

# Automatically restart if it fails, hangs, or crashes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target