# Copy this file to .env and adjust values for your local environment.
# Variables that are commented out are optional or have sensible defaults.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
SECRET_KEY=a-really-long-and-unique-key-that-nobody-knows

# WebAuthn / FIDO2 (must match the domain the app is served from)
RP_ID=localhost
RP_ORIGIN=http://localhost:5000
RP_NAME=Expense App

# ---------------------------------------------------------------------------
# Admin seed account  (used by: flask dbinit admin)
# ---------------------------------------------------------------------------
ADMIN_NOREPLY_SENDER=no-reply@expenseapp
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pw
ADMIN_EMAIL=admin@expenseapp

# ---------------------------------------------------------------------------
# Database
# DB_TYPE options: sqlite | mysql | mariadb | postgres | oracle | oci
# ---------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PW=pw
DB_NAME=expenseapp

# Optional: provide a full SQLAlchemy URL to override all DB_* variables above
#DATABASE_URL=mysql+pymysql://user:pw@localhost:3306/expenseapp?charset=utf8mb4

# Oracle Cloud (oci / oracle-adb) only
#TNS_ADMIN=/opt/OCIWallet
#WALLET_PW=pw

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_SERVER=localhost
MAIL_PORT=1025
# Set one of MAIL_USE_TLS or MAIL_USE_SSL (any non-empty value enables it)
#MAIL_USE_TLS=1
#MAIL_USE_SSL=1
#MAIL_USERNAME=
#MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Storage  (local | s3)
# ---------------------------------------------------------------------------
STORAGE_DEFAULT_BACKEND=local
STORAGE_LOCAL_PATH=./app

# Local image sub-paths (relative to STORAGE_LOCAL_PATH)
#IMAGE_DEFAULT_FORMAT=JPEG
#IMAGE_TMP_PATH=static/tmp
#IMAGE_IMG_PATH=static/img
#IMAGE_TIMG_PATH=static/timg

# S3 / MinIO
#S3_BUCKET_NAME=expenseapp-bucket
#S3_REGION=eu-central-1
#S3_ENDPOINT_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=pw
# Optional: override the full Redis URL (takes precedence over the fields above)
#REDIS_URL=redis://:pw@localhost:6379/0

# ---------------------------------------------------------------------------
# Backup
# ---------------------------------------------------------------------------
# Backend for backup storage: 'local' or 's3'. Defaults to STORAGE_DEFAULT_BACKEND.
#BACKUP_STORAGE_BACKEND=local
#BACKUP_STORAGE_PATH=backups
#BACKUP_RETENTION_COUNT=4
#BACKUP_SCHEDULE_DAY_OF_WEEK=sun
#BACKUP_SCHEDULE_HOUR=2
